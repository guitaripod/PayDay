    "Credit packs are temporarily unavailable from the App Store. You can keep using the app fully — please try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Credit-Pakete sind im App Store vorübergehend nicht verfügbar. Sie können die App uneingeschränkt weiter nutzen – bitte versuchen Sie es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los packs de créditos no están disponibles temporalmente en el App Store. Puedes seguir usando la app con normalidad; inténtalo más tarde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krediittipaketteja ei ole tilapäisesti saatavilla App Storesta. Voit jatkaa sovelluksen käyttöä täysin normaalisti – yritä myöhemmin uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les packs de crédits sont temporairement indisponibles sur l'App Store. Vous pouvez continuer à utiliser l'app normalement — réessayez plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pacchetti di crediti non sono temporaneamente disponibili su App Store. Puoi continuare a usare l'app senza limiti: riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クレジットパックは現在 App Store で購入できません。アプリはこれまでどおりすべて使えます。しばらくしてからお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 App Store에서 크레딧 팩을 구매할 수 없습니다. 앱은 그대로 모두 사용할 수 있으니 나중에 다시 시도해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creditpakketten zijn tijdelijk niet beschikbaar in de App Store. Je kunt de app volledig blijven gebruiken — probeer het later opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakiety kredytów są chwilowo niedostępne w App Store. Możesz dalej w pełni korzystać z aplikacji — spróbuj później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pacotes de créditos estão temporariamente indisponíveis na App Store. Você pode continuar usando o app normalmente — tente de novo mais tarde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "积分包目前无法从 App Store 购买。你仍可完整使用本 App，请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前無法從 App Store 購買點數包。你仍可完整使用本 App，請稍後再試。"
          }
        }
      }
    },
