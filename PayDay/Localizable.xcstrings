          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求通过加密连接发送到 Pay Day 的后端（由 Midgar Oy 运营），再转发给 OpenAI 处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請求會透過加密連線傳送至 Pay Day 的後端（由 Midgar Oy 營運），再轉交 OpenAI 處理。"
