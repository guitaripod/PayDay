    "Use scheme:id — the scheme is a 4-digit code, e.g. 0216:003712345678." : {
      "comment" : "Peppol participant id format hint; \"scheme:id\" is literal syntax",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format scheme:id verwenden – das Schema ist ein 4-stelliger Code, z. B. 0216:003712345678."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el formato scheme:id: el esquema es un código de 4 dígitos, p. ej., 0216:003712345678."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä muotoa scheme:id – scheme on 4-numeroinen koodi, esim. 0216:003712345678."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le format scheme:id — le schéma est un code à 4 chiffres, par ex. 0216:003712345678."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il formato scheme:id: lo schema è un codice di 4 cifre, es. 0216:003712345678."
          }
