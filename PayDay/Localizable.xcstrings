    "The AI request failed — check your connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI-Anfrage ist fehlgeschlagen – prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solicitud a la IA falló: comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La requête IA a échoué — vérifiez votre connexion et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La richiesta all'IA non è riuscita: controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI へのリクエストが失敗しました。接続を確認してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 요청이 실패했습니다. 연결을 확인한 뒤 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A solicitação à IA falhou — verifique sua conexão e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 请求失败——请检查网络连接后重试。"
          }
        }
      }
    },
    "The PDF couldn't be written for sharing. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das PDF konnte nicht zum Teilen erstellt werden. Bitte erneut versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo preparar el PDF para compartir. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le PDF n'a pas pu être préparé pour le partage. Réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile preparare il PDF per la condivisione. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有用の PDF を書き出せませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유할 PDF를 만들지 못했습니다. 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível preparar o PDF para compartilhar. Tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法生成用于共享的 PDF，请重试。"
          }
        }
      }
    },
    "The content is used only to generate your draft. It is not stored by us after the response, not used to train AI models, and never used for advertising. You review and edit every draft." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Inhalte werden ausschließlich zur Erstellung Ihres Entwurfs verwendet. Wir speichern sie nach der Antwort nicht, nutzen sie nicht zum Training von KI-Modellen und niemals für Werbung. Jeden Entwurf prüfen und bearbeiten Sie selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido solo se usa para generar tu borrador. No lo almacenamos después de la respuesta, no se usa para entrenar modelos de IA ni nunca con fines publicitarios. Tú revisas y editas cada borrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu sert uniquement à générer votre brouillon. Nous ne le conservons pas après la réponse, il ne sert pas à entraîner des modèles d'IA et jamais à la publicité. Vous relisez et modifiez chaque brouillon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contenuto serve solo a generare la tua bozza. Non lo conserviamo dopo la risposta, non viene usato per addestrare modelli di IA né mai per la pubblicità. Sei tu a rivedere e modificare ogni bozza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内容は下書きの生成にのみ使用されます。応答後に当社が保存することはなく、AI モデルの学習にも広告にも一切利用しません。下書きはすべてご自身で確認・編集できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내용은 초안 생성에만 사용됩니다. 응답 후에는 저장하지 않으며, AI 모델 학습이나 광고에는 절대 사용하지 않습니다. 모든 초안은 직접 검토하고 수정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conteúdo é usado apenas para gerar seu rascunho. Não o armazenamos após a resposta, não o usamos para treinar modelos de IA e nunca para publicidade. Você revisa e edita cada rascunho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些内容仅用于生成你的草稿。我们在收到回复后不会保存，不用于训练 AI 模型，也绝不用于广告。每份草稿都由你审阅和修改。"
          }
        }
      }
    },
    "The invoice couldn't be saved. Please try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Rechnung konnte nicht gesichert werden. Bitte versuchen Sie es erneut."
          }
