    "Add the businesses you invoice. Their VAT ID and Peppol address power compliant e-invoices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legen Sie die Unternehmen an, denen Sie Rechnungen stellen. USt-IdNr. und Peppol-Adresse machen konforme E-Rechnungen möglich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade las empresas a las que facturas. Su n.º de IVA y su dirección Peppol hacen posibles las facturas electrónicas conformes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää yritykset, joita laskutat. Niiden ALV-tunnus ja Peppol-osoite mahdollistavat vaatimustenmukaiset verkkolaskut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les entreprises que vous facturez. Leur n° de TVA et leur adresse Peppol rendent possibles des factures électroniques conformes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi le aziende a cui fatturi. Partita IVA e indirizzo Peppol rendono possibili le fatture elettroniche conformi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請求先の企業を登録します。VAT 番号と Peppol アドレスが、準拠した電子インボイスの土台になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인보이스를 보내는 회사를 추가하세요. VAT 번호와 Peppol 주소가 규정에 맞는 전자 인보이스의 기반이 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg de bedrijven toe die je factureert. Hun btw-nummer en Peppol-adres maken conforme e-facturen mogelijk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj firmy, którym wystawiasz faktury. Ich NIP i adres Peppol umożliwiają zgodne e-faktury."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione as empresas para as quais você fatura. O nº de IVA e o endereço Peppol viabilizam faturas eletrônicas em conformidade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加你开票的企业。其增值税税号和 Peppol 地址是合规电子发票的基础。"
          }
        }
      }
    },
