    "Create your first invoice. It's free, unlimited, and ready for EU e-invoicing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie Ihre erste Rechnung. Kostenlos, unbegrenzt und bereit für die EU-E-Rechnung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea tu primera factura. Gratis, sin límites y lista para la facturación electrónica europea."
          }
        },
        "fi" : {
          "stringUnit" : {
