    "Beautiful invoices for free — and EU-compliant e-invoices (Factur-X, Peppol) when you need them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schöne Rechnungen kostenlos – und EU-konforme E-Rechnungen (Factur-X, Peppol), wenn Sie sie brauchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facturas bonitas gratis y facturas electrónicas conformes con la UE (Factur-X, Peppol) cuando las necesites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De belles factures gratuitement — et des factures électroniques conformes à l'UE (Factur-X, Peppol) quand vous en avez besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatture belle e gratuite — e fatture elettroniche conformi alle norme UE (Factur-X, Peppol) quando servono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "美しい請求書を無料で。必要なときは EU 準拠の電子インボイス（Factur-X、Peppol）も。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아름다운 인보이스를 무료로. 필요할 때는 EU 규정을 지키는 전자 인보이스(Factur-X, Peppol)까지."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faturas bonitas de graça — e faturas eletrônicas em conformidade com a UE (Factur-X, Peppol) quando você precisar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费开出漂亮的发票——需要时还能生成符合欧盟规范的电子发票（Factur-X、Peppol）。"
          }
        }
      }
    },
