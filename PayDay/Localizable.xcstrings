    "%@: e-invoicing is mandatory for every business since %@." : {
      "comment" : "Welcome screen hook; arguments are a country name and a date",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: E-Rechnungen sind für jedes Unternehmen seit %2$@ Pflicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: la facturación electrónica es obligatoria para todas las empresas desde %2$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: verkkolaskutus on pakollista kaikille yrityksille %2$@ alkaen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : facturation électronique obligatoire pour toutes les entreprises depuis %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: fatturazione elettronica obbligatoria per tutte le imprese dal %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：%2$@より、すべての事業者に電子インボイスが義務化。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@부터 모든 사업자에게 전자 인보이스 의무화."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: e-facturatie is sinds %2$@ verplicht voor elk bedrijf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: e-fakturowanie obowiązkowe dla każdej firmy od %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: a fatura eletrônica é obrigatória para todas as empresas desde %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：自 %2$@ 起，电子发票对所有企业强制要求。"
          }
        },
        "zh-Hant" : {
