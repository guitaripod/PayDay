        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "견적서를 만들어 보내고, 수락되면 인보이스로 변환하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
