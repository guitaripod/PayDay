    "%@ %@" : {
      "comment" : "Invoice PDF quantity cell: amount then unit of measure, e.g. 8 hour",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@ on %@" : {
      "comment" : "Invoice PDF VAT breakdown line: category, rate, taxable base amount",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ on %3$@"
          }
        }
      }
    },
    "%@ %@, %@" : {
      "comment" : "VoiceOver label for a document row: document kind, document number, client name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@, %3$@"
          }
        }
      }
    },
