    "Only the text you type or the photo you choose, plus the invoice currency. Your client list and saved invoices are not sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Text, den Sie eingeben, oder das Foto, das Sie auswählen, sowie die Rechnungswährung. Ihre Kundenliste und gespeicherte Rechnungen werden nicht gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo el texto que escribes o la foto que eliges, además de la moneda de la factura. Tu lista de clientes y tus facturas guardadas no se envían."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain kirjoittamasi teksti tai valitsemasi kuva sekä laskun valuutta. Asiakasluetteloasi ja tallennettuja laskujasi ei lähetetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement le texte que vous saisissez ou la photo que vous choisissez, ainsi que la devise de la facture. Votre liste de clients et vos factures enregistrées ne sont pas envoyées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo il testo che scrivi o la foto che scegli, più la valuta della fattura. Il tuo elenco clienti e le fatture salvate non vengono inviati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信されるのは、入力した文章または選んだ写真と、請求書の通貨だけです。取引先リストや保存済みの請求書は送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력한 문장이나 선택한 사진, 그리고 인보이스 통화만 전송됩니다. 거래처 목록과 저장된 인보이스는 전송되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen de tekst die je typt of de foto die je kiest, plus de valuta van de factuur. Je klantenlijst en bewaarde facturen worden niet verstuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko tekst, który wpiszesz, lub zdjęcie, które wybierzesz, oraz waluta faktury. Twoja lista kontrahentów i zapisane faktury nie są wysyłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas o texto que você digita ou a foto que escolhe, além da moeda da fatura. Sua lista de clientes e suas faturas salvas não são enviadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只发送你输入的文字或选择的照片，以及发票币种。你的客户名单和已保存的发票不会被发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會傳送你輸入的文字或選擇的照片，以及發票幣別。你的客戶名單和已儲存的發票不會被傳送。"
          }
        }
      }
    },
