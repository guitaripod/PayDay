    "Subscriptions auto-renew unless cancelled at least 24h before the period ends. Manage in Apple ID settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abos verlängern sich automatisch, sofern sie nicht mindestens 24 Stunden vor Ende des Zeitraums gekündigt werden. Verwaltung in den Apple-ID-Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones se renuevan automáticamente salvo que se cancelen al menos 24 h antes del fin del periodo. Gestiónalas en los ajustes de tu Apple ID."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilaukset uusiutuvat automaattisesti, ellei niitä peruuteta vähintään 24 h ennen jakson päättymistä. Hallinnoi Apple ID -asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements se renouvellent automatiquement sauf résiliation au moins 24 h avant la fin de la période. Gestion dans les réglages de votre compte Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli abbonamenti si rinnovano automaticamente salvo disdetta almeno 24 ore prima della fine del periodo. Gestiscili nelle impostazioni dell'Apple ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは、期間終了の 24 時間前までに解約しない限り自動更新されます。管理は Apple ID の設定から行えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독은 기간 종료 24시간 전까지 해지하지 않으면 자동으로 갱신됩니다. Apple ID 설정에서 관리할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementen worden automatisch verlengd, tenzij je ze minstens 24 uur voor het einde van de periode opzegt. Beheer dit in je Apple ID-instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskrypcje odnawiają się automatycznie, o ile nie zostaną anulowane co najmniej 24 h przed końcem okresu. Zarządzaj w ustawieniach Apple ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas são renovadas automaticamente, a menos que sejam canceladas pelo menos 24 h antes do fim do período. Gerencie nos ajustes do Apple ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅将自动续订，除非在当期结束前至少 24 小时取消。可在 Apple ID 设置中管理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非在當期結束前至少 24 小時取消，否則訂閱將自動續訂。可在 Apple ID 設定中管理。"
          }
        }
      }
    },
