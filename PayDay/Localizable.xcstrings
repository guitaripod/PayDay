    "Create an estimate to send a quote — convert it to an invoice when it's accepted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie ein Angebot für Ihren Kunden – und wandeln Sie es in eine Rechnung um, sobald es angenommen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un presupuesto para enviárselo a tu cliente y conviértelo en factura cuando lo acepte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo tarjous asiakkaallesi – muunna se laskuksi heti, kun asiakas hyväksyy sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un devis à envoyer à votre client — convertissez-le en facture dès qu'il est accepté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un preventivo da inviare al cliente e convertilo in fattura quando viene accettato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見積書を作成して送り、受注したら請求書に変換できます。"
