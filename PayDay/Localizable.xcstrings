    "Ireland phases in mandatory B2B e-invoicing over Peppol from 1 November 2028, starting with large companies, and extends it to all other VAT-registered businesses in November 2029." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irland führt die B2B-E-Rechnungspflicht über Peppol ab 1. November 2028 schrittweise ein, zunächst für Großunternehmen, und weitet sie im November 2029 auf alle übrigen umsatzsteuerpflichtigen Unternehmen aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irlanda implanta de forma progresiva la facturación electrónica B2B obligatoria por Peppol desde el 1 de noviembre de 2028, empezando por las grandes empresas, y la extiende a todas las demás empresas registradas a efectos de IVA en noviembre de 2029."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irlanti ottaa pakollisen yritysten välisen verkkolaskutuksen käyttöön vaiheittain Peppolin kautta 1.11.2028 alkaen, ensin suuryrityksille, ja laajentaa sen kaikkiin muihin alv-rekisteröityihin yrityksiin marraskuussa 2029."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'Irlande met en place progressivement la facturation électronique B2B obligatoire via Peppol à partir du 1er novembre 2028, en commençant par les grandes entreprises, puis l'étend à toutes les autres entreprises assujetties à la TVA en novembre 2029."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'Irlanda introduce gradualmente la fatturazione elettronica B2B obbligatoria tramite Peppol dal 1° novembre 2028, a partire dalle grandi imprese, ed estende l'obbligo a tutte le altre imprese con partita IVA nel novembre 2029."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイルランドは2028年11月1日から、Peppol経由の義務的B2B電子インボイスを大企業から段階的に導入し、2029年11月にはその他すべての付加価値税登録事業者にも拡大します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아일랜드는 2028년 11월 1일부터 Peppol을 통한 의무적 B2B 전자 인보이스를 대기업부터 단계적으로 도입하며, 2029년 11월에는 나머지 모든 부가가치세 등록 사업자로 확대합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ierland voert verplichte b2b-e-facturatie via Peppol gefaseerd in vanaf 1 november 2028, te beginnen bij grote bedrijven, en breidt dit in november 2029 uit naar alle overige btw-plichtige ondernemingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irlandia wprowadza obowiązkowe e-fakturowanie B2B przez Peppol etapami od 1 listopada 2028 r., zaczynając od dużych firm, a w listopadzie 2029 r. rozszerza je na wszystkie pozostałe firmy zarejestrowane jako podatnicy VAT."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Irlanda implementa em fases a fatura eletrônica B2B obrigatória pelo Peppol a partir de 1º de novembro de 2028, começando pelas grandes empresas, e a estende a todas as demais empresas registradas para o IVA em novembro de 2029."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "爱尔兰将于 2028 年 11 月 1 日起分阶段推行强制性 B2B 电子发票（通过 Peppol），首先适用于大型企业，并于 2029 年 11 月扩大到所有其他增值税注册企业。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "愛爾蘭將於 2028 年 11 月 1 日起分階段推行強制性 B2B 電子發票（透過 Peppol），首先適用於大型企業，並於 2029 年 11 月擴大至所有其他加值稅登記企業。"
          }
        }
      }
    },
    "Issue EN 16931 e-invoices that %@'s mandate accepts." : {
      "comment" : "Paywall reason; the argument is a country name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie EN-16931-E-Rechnungen, die die Vorgaben von %@ erfüllen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emite facturas electrónicas EN 16931 que cumplen la normativa de %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laadi EN 16931 -verkkolaskuja, jotka täyttävät maan %@ vaatimukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Émettez des factures électroniques EN 16931 conformes à la réglementation de %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emetti fatture elettroniche EN 16931 conformi alla normativa di %@."
          }
        },
        "ja" : {
