    "%@ has no national B2B e-invoicing mandate yet. EU-wide cross-border e-invoicing becomes mandatory on 1 July 2030." : {
      "comment" : "Generic EU fallback; the argument is a country name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat noch keine nationale B2B-E-Rechnungspflicht. EU-weite grenzüberschreitende E-Rechnungen werden ab 1. Juli 2030 verpflichtend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aún no tiene una obligación nacional de facturación electrónica B2B. La facturación electrónica transfronteriza en toda la UE será obligatoria a partir del 1 de julio de 2030."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: ei vielä kansallista yritysten välistä verkkolaskutuspakkoa. EU:n laajuisesta rajat ylittävästä verkkolaskutuksesta tulee pakollista 1.7.2030."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas encore d'obligation nationale de facturation électronique B2B. La facturation électronique transfrontalière deviendra obligatoire dans toute l'UE à partir du 1er juillet 2030."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha ancora un obbligo nazionale di fatturazione elettronica B2B. La fatturazione elettronica transfrontaliera diventerà obbligatoria in tutta l'UE dal 1° luglio 2030."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にはまだ国内のB2B電子インボイス義務はありません。EU域内の越境電子インボイスは2030年7月1日から義務化されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에는 아직 국내 B2B 전자 인보이스 의무가 없습니다. EU 전역의 국경 간 전자 인보이스는 2030년 7월 1일부터 의무화됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft nog geen nationale b2b-e-factureringsverplichting. EU-brede grensoverschrijdende e-facturatie wordt verplicht vanaf 1 juli 2030."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie ma jeszcze krajowego obowiązku e-fakturowania B2B. Ogólnounijne transgraniczne e-fakturowanie stanie się obowiązkowe od 1 lipca 2030 r."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ainda não tem uma obrigação nacional de fatura eletrônica B2B. A fatura eletrônica transfronteiriça em toda a UE se tornará obrigatória a partir de 1º de julho de 2030."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@目前还没有全国性的 B2B 电子发票强制规定。欧盟范围内的跨境电子发票将于 2030 年 7 月 1 日起强制实施。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@目前尚無全國性的 B2B 電子發票強制規定。歐盟範圍內的跨境電子發票將於 2030 年 7 月 1 日起強制實施。"
          }
        }
      }
    },
