    },
    "The request goes over an encrypted connection to Pay Day's backend (operated by Midgar Oy), which forwards it to OpenAI for processing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anfrage geht über eine verschlüsselte Verbindung an das Backend von Pay Day (betrieben von Midgar Oy), das sie zur Verarbeitung an OpenAI weiterleitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solicitud se envía por una conexión cifrada al backend de Pay Day (operado por Midgar Oy), que la reenvía a OpenAI para su procesamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La requête est transmise via une connexion chiffrée au backend de Pay Day (exploité par Midgar Oy), qui la transfère à OpenAI pour traitement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La richiesta viaggia su una connessione cifrata verso il backend di Pay Day (gestito da Midgar Oy), che la inoltra a OpenAI per l'elaborazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストは暗号化された通信で Pay Day のバックエンド（運営: Midgar Oy）に送られ、そこから処理のために OpenAI へ転送されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청은 암호화된 연결을 통해 Pay Day 백엔드(운영: Midgar Oy)로 전송되며, 처리를 위해 OpenAI로 전달됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A solicitação vai por uma conexão criptografada até o backend do Pay Day (operado pela Midgar Oy), que a encaminha para a OpenAI processar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求通过加密连接发送到 Pay Day 的后端（由 Midgar Oy 运营），再转发给 OpenAI 处理。"
          }
        }
      }
    },
