    "every business must accept e-invoices" : {
      "comment" : "Deadline scope phrase",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jedes Unternehmen muss E-Rechnungen empfangen können"
